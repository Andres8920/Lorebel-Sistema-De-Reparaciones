# ========================================
# Laravel .gitignore (mejores prácticas)
# ========================================

# Dependencias
/vendor/
/node_modules/
package-lock.json
yarn.lock

# Entorno
.env
.env.backup
.env.production

# Laravel: cache, sesiones, vistas compiladas
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*.log

# Laravel: no rastrear el directorio de uploads local
/storage/app/public/*

# Bootstrap cache
/bootstrap/cache/*.php

# Build de assets (Vite)
/public/build/
/public/hot

# Backend Node (Express) — tiene su propio .gitignore
/backend/node_modules/
/backend/.env

# Frontend (SPA) — tiene su propio .gitignore
/frontend/node_modules/
/frontend/dist/
/frontend/.env

# Backups locales (no subir al repo)
/A Backups/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# IDEs y editores
.vscode/
.idea/
*.swp
*.swo
*~

# Logs generales
*.log
npm-debug.log*
yarn-debug.log*

# Compilados
dist/
build/
